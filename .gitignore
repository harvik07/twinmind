# Datasets and checkpoints: anchored to the repo root with a leading slash, so
# these do NOT also match src/twinmind/data/ and src/twinmind/models/.
/data/**
!/data/**/
!/data/**/.gitkeep
/models/**
!/models/**/
!/models/**/.gitkeep
mlruns/

# Secrets. .env holds the real values; .env.example holds placeholders only.
.env
.env.*
!.env.example
# Kaggle API tokens, wherever they land.
kaggle.json
.kaggle/
# Other credential shapes worth refusing outright.
*.pem
*.key
credentials.json
service-account*.json

*.ckpt
*.pt
*.pth

__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

/reports/llm_calls*.jsonl
/reports/agent_runs.jsonl
/reports/dashboard_runs.jsonl
/reports/agent_memory.duckdb
/reports/benchmark.json
/reports/figures/*
!/reports/figures/.gitkeep
# Rendered report figures are tracked so the model cards' images work on GitHub.
!/reports/figures/*.png
!/reports/figures/*.svg

.DS_Store
.kaggle_staging/

# Copy to .env and fill in. .env is gitignored.
GROQ_API_KEY=
# Kaggle offers two credential schemes. Either works; the token is preferred.
#   1. Access token (kaggle >= 2.x): a single KGAT_-prefixed value.
#      Settings -> API -> "Generate New Token".
KAGGLE_API_TOKEN=
#   2. Legacy pair: username plus a 32-character hex key, as in kaggle.json.
#      A KGAT_ token does NOT belong in KAGGLE_KEY -- it is a different
#      scheme and the server rejects it with 401.
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional: DEBUG | INFO | WARNING | ERROR
TWINMIND_LOG_LEVEL=INFO
